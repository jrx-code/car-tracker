# Copy to /etc/tracker-hub/tracker-hub.env on the LXC (chmod 640, owner tracker).
# Secret values come from the password manager, never from this file.

# --- MQTT (EMQX) ---
MQTT_HOST=mqtt.example.com
MQTT_PORT=8883
MQTT_USER=tracker-hub
MQTT_PASS=REPLACE_ME
MQTT_TLS=true
# Leave empty to use the system CA store (the broker cert is Let's Encrypt).
MQTT_CA=
TOPIC_PREFIX=cartracker

# --- HTTP ---
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
# Optional. Lets a script write (commands, config) with the X-Api-Token header.
# Empty no longer means open: without it, writes need admin mode.
API_TOKEN=

# --- Admin mode ---
# The reverse proxy runs Authentik forward_auth on /admin, /api/admin and /device
# and passes X-Authentik-Username. The hub trusts that header only from
# TRUSTED_PROXIES and only for users on ADMIN_USERS (comma separated).
ADMIN_USERS=admin
# Address of the reverse proxy. Empty: admin mode is off.
TRUSTED_PROXIES=
# X-Admin-Pass of the trackers' own portals, sent on behalf of a signed-in
# admin. One value for the fleet, from the password manager.
DEVICE_ADMIN_PASS=REPLACE_ME

# --- Storage ---
DB_PATH=/var/lib/tracker-hub/tracker.db
# Raw positions expire, trips stay. See README, section on privacy.
RETAIN_POSITIONS_DAYS=180

# --- Filters ---
MAX_PLAUSIBLE_SPEED_KMH=300
MAX_HDOP=5.0
STALE_AFTER_S=5400
